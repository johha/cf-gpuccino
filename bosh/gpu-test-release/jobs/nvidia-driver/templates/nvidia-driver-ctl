#!/bin/bash
# Control script for nvidia-driver job
# This is a no-op process since the driver is a kernel module, not a daemon

case $1 in
    start)
        # Driver is loaded at boot/pre-start, nothing to start
        echo "NVIDIA driver is loaded as a kernel module"
        nvidia-smi --query-gpu=name,driver_version --format=csv,noheader || true
        ;;
    stop)
        # Don't unload the driver - other jobs may depend on it
        echo "NVIDIA driver stop requested (no-op, driver remains loaded)"
        ;;
    *)
        echo "Usage: nvidia-driver-ctl {start|stop}"
        exit 1
        ;;
esac

exit 0
