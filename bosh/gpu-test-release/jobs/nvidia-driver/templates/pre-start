#!/bin/bash
set -e

LOG_DIR=/var/vcap/sys/log/nvidia-driver
mkdir -p "${LOG_DIR}"
exec > >(tee -a "${LOG_DIR}/pre-start.log") 2>&1

echo "=== NVIDIA Driver Pre-Start (Package-based): $(date) ==="

KERNEL_VERSION=$(uname -r)
DRIVER_PKG=/var/vcap/packages/nvidia-driver-570
TOOLKIT_PKG=/var/vcap/packages/nvidia-container-toolkit

echo "Kernel version: ${KERNEL_VERSION}"

# Check if driver already installed and working
if command -v nvidia-smi &> /dev/null && nvidia-smi &> /dev/null; then
    echo "NVIDIA driver already installed and working, skipping"
    nvidia-smi
    exit 0
fi

echo "Installing NVIDIA driver from package..."

# Step 1: Install kernel module
echo "Installing kernel module..."
mkdir -p /lib/modules/${KERNEL_VERSION}/updates/dkms/
cp ${DRIVER_PKG}/nvidia*.ko /lib/modules/${KERNEL_VERSION}/updates/dkms/

# Update module dependencies
echo "Running depmod..."
depmod -a

# Load kernel module
echo "Loading nvidia module..."
modprobe nvidia || {
    echo "ERROR: Failed to load nvidia module"
    dmesg | tail -20
    exit 1
}

# Verify module loaded
if ! lsmod | grep -q nvidia; then
    echo "ERROR: nvidia module not loaded"
    lsmod | grep -i nvidia || true
    exit 1
fi

echo "nvidia module loaded successfully"
lsmod | grep nvidia

# Step 2: Install userspace tools
echo "Installing nvidia-smi and tools..."
cp ${DRIVER_PKG}/nvidia-* /usr/bin/ 2>/dev/null || true
chmod +x /usr/bin/nvidia-* 2>/dev/null || true

# Step 3: Install libraries
echo "Installing NVIDIA libraries..."
cp ${DRIVER_PKG}/libnvidia-*.so.* /usr/lib/x86_64-linux-gnu/ 2>/dev/null || true
cp ${DRIVER_PKG}/libcuda.so.* /usr/lib/x86_64-linux-gnu/ 2>/dev/null || true
cp ${DRIVER_PKG}/libnvcuvid.so.* /usr/lib/x86_64-linux-gnu/ 2>/dev/null || true

# Create symlinks for libraries
cd /usr/lib/x86_64-linux-gnu
for lib in libnvidia-*.so.*.*; do
    [ -f "$lib" ] || continue
    soname="${lib%.*.*}"
    [ -L "$soname" ] || ln -sf "$lib" "$soname"
done
for lib in libcuda.so.*.*; do
    [ -f "$lib" ] || continue
    ln -sf "$lib" libcuda.so.1
    ln -sf "$lib" libcuda.so
done

# Update library cache
echo "Updating library cache..."
ldconfig

# Step 4: Install nvidia-container-toolkit
echo "Installing nvidia-container-toolkit..."
cp -r ${TOOLKIT_PKG}/usr/bin/* /usr/bin/ 2>/dev/null || true
chmod +x /usr/bin/nvidia-* 2>/dev/null || true

# Create CDI directories
mkdir -p /var/vcap/data/cdi/specs
mkdir -p /etc/cdi

# Generate CDI spec
if command -v nvidia-ctk &> /dev/null; then
    echo "Generating CDI spec..."
    nvidia-ctk cdi generate --output=/var/vcap/data/cdi/specs/nvidia.yaml || \
        echo "WARNING: CDI generation failed, will retry later"
fi

# Verify installation
echo ""
echo "=== Verification ==="
echo "nvidia-smi:"
nvidia-smi

echo ""
echo "nvidia-container-toolkit:"
nvidia-ctk --version || echo "nvidia-ctk not available"

echo ""
echo "CDI spec:"
ls -la /var/vcap/data/cdi/specs/ || true

echo ""
echo "=== NVIDIA Driver Installation Complete ==="
echo "Installation time: ~30 seconds (vs 5-7 min with runtime install)"
