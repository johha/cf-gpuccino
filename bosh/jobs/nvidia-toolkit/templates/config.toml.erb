# nvidia-container-toolkit configuration
# Generated by BOSH template: config.toml.erb
# Do not edit this file manually – changes will be overwritten on the next BOSH deploy.

[nvidia-container-cli]
  # Root directory where the NVIDIA driver libraries are found on the host.
  # The toolkit auto-detects this on most Linux distributions.
  # ldconfig = "@/sbin/ldconfig"

  # Enable CDI device injection support.
  # When enabled the runtime resolves "nvidia.com/gpu=N" CDI names to the
  # full set of device nodes, mounts, and environment variables.
  # Note: BOSH property names use underscores (cdi_enabled) while the TOML
  # key uses hyphens (cdi-enabled) to match the nvidia-container-toolkit spec.
  cdi-enabled = <%= p("cdi_enabled") %>

[nvidia-container-runtime]
  # Log verbosity for the NVIDIA container runtime shim.
  log-level = "info"

  # Directories searched for CDI spec files.
  # This list must include the same path used by the garden job's
  # --cdi-spec-dirs flag so that device name resolution is consistent.
  cdi-spec-dirs = ["<%= p("cdi_spec_dir") %>", "/etc/cdi", "/var/run/cdi"]

  # Modes: "auto" selects CDI when a CDI device is requested, otherwise
  # falls back to the legacy device injection approach.
  mode = "auto"

[nvidia-container-runtime.hooks]
  # Path to the nvidia-container-toolkit hook binary.
  prestart = ["<%= p("toolkit_root") %>/bin/nvidia-container-runtime-hook", "prestart"]
