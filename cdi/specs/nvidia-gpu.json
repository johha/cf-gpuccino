{
  "cdiVersion": "0.5.0",
  "kind": "nvidia.com/gpu",
  "devices": [
    {
      "name": "0",
      "containerEdits": {
        "deviceNodes": [
          {
            "path": "/dev/nvidia0",
            "type": "c",
            "major": 195,
            "minor": 0,
            "permissions": "rwm"
          },
          {
            "path": "/dev/nvidiactl",
            "type": "c",
            "major": 195,
            "minor": 255,
            "permissions": "rwm"
          },
          {
            "path": "/dev/nvidia-uvm",
            "type": "c",
            "major": 510,
            "minor": 0,
            "permissions": "rwm"
          }
        ],
        "env": [
          "CUDA_VISIBLE_DEVICES=0"
        ]
      }
    }
  ],
  "containerEdits": {
    "env": [
      "LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH",
      "NVIDIA_DRIVER_CAPABILITIES=compute,utility"
    ],
    "mounts": [
      {
        "hostPath": "/usr/lib/x86_64-linux-gnu/libnvidia-container.so.1",
        "containerPath": "/usr/lib/x86_64-linux-gnu/libnvidia-container.so.1",
        "options": ["ro", "nosuid", "nodev", "bind"]
      },
      {
        "hostPath": "/usr/local/cuda/lib64",
        "containerPath": "/usr/local/cuda/lib64",
        "options": ["ro", "nosuid", "nodev", "bind"]
      },
      {
        "hostPath": "/usr/bin/nvidia-smi",
        "containerPath": "/usr/bin/nvidia-smi",
        "options": ["ro", "nosuid", "nodev", "bind"]
      }
    ]
  }
}
